<% content_for :title, "Review case ##{@review_case.id} · Catalog Consolidation" %>

<div class="page-heading">
  <p class="eyebrow">Seller intake / Review case</p>
  <h1>Case #<%= @review_case.id %></h1>
  <p><span class="outcome outcome--<%= @review_case.status %>"><%= @review_case.status.humanize %></span> · <strong><%= @review_case.seller_item.seller_name %></strong> / ID <%= @review_case.seller_item.seller_product_id %></p>
  <p>Opened from <%= link_to "batch ##{@review_case.batch_id}, row #{@review_case.source_position}", batch_path(@review_case.batch) %>.</p>
</div>

<section class="panel case-summary" aria-labelledby="case-summary-heading">
  <h2 id="case-summary-heading">Current case state</h2>
  <p><strong>Review reason:</strong> <%= @review_case.reason %></p>
  <% if @review_case.status == "superseded" %>
    <p>This is a historical case. A newer source identity superseded it; this record remains available for audit.</p>
  <% elsif @review_case.status == "resolved" %>
    <p>This case has a final decision. The import results below remain as recorded when each batch ran.</p>
  <% else %>
    <% if @creation_state == :invalid_input %>
      <p>This older case has input that fails the current text rule. Correct Name, Brand, or Category below if possible. If Id or SellerName is unsafe, submit a corrected row in a new import. No Catalog action is available from this input.</p>
    <% elsif @creation_state == :ready %>
      <p>This case is still pending and ready for explicit creation. No product or final decision has been recorded yet.</p>
    <% else %>
      <p>This case is pending review. No final decision has been recorded.</p>
    <% end %>
  <% end %>
  <%= render "conflict", conflict: @review_case.conflicting_association %>
  <% if @review_case.status == "pending" && @review_case.seller_item.product_id %>
    <p class="conflict-note">This seller ID is currently associated with product #<%= @review_case.seller_item.product_id %>. It stays linked there until a final reassignment or conflict decision commits.</p>
  <% end %>
  <% if @review_case.review_decision %>
    <% decision = @review_case.review_decision %>
    <p><strong>Final decision:</strong> <%= decision.result.humanize %> · product #<%= decision.product_id %> · by <%= decision.reviewer %> at <%= time_tag decision.decided_at, decision.decided_at.strftime("%Y-%m-%d %H:%M %Z") %>.</p>
    <% if decision.reason.present? %><p><strong>Decision reason:</strong> <%= decision.reason %></p><% end %>
    <% if decision.displaced_seller_item_id %><p>Displaced seller item #<%= decision.displaced_seller_item_id %>.</p><% end %>
    <% if decision.declined_seller_item_id %><p>Declined seller item #<%= decision.declined_seller_item_id %>.</p><% end %>
  <% end %>
</section>

<section class="case-section" aria-labelledby="identity-heading">
  <h2 id="identity-heading">Source and comparison</h2>
  <div class="panel table-wrap">
    <%= render "identity", title: "Original seller row", value_label: "Original value", input: @review_case.source_input, comparison: @review_case.source_comparison %>
  </div>
  <% if @corrections.any? %>
    <% @corrections.each do |correction| %>
      <div class="panel table-wrap stacked-panel">
        <p class="history-meta">Correction by <%= correction.reviewer %> at <%= time_tag correction.corrected_at, correction.corrected_at.strftime("%Y-%m-%d %H:%M %Z") %></p>
        <%= render "identity", title: "Corrected values", value_label: "Corrected value", input: correction.corrected_input, comparison: correction.corrected_comparison %>
      </div>
    <% end %>
  <% else %>
    <p class="muted">No corrections have been recorded. The original source remains the comparison input.</p>
  <% end %>
  <details class="source-detail"><summary>View original source JSON</summary><pre class="source-text"><%= JSON.pretty_generate(@review_case.source_input) %></pre></details>
</section>

<section class="case-section" aria-labelledby="candidates-heading">
  <h2 id="candidates-heading">Candidate evidence</h2>
  <p class="muted">Evidence revision <%= @review_case.evidence_revision %>. Scores and differences explain possible matches; they do not authorize a link.</p>
  <% if @candidates.empty? %>
    <div class="panel empty-state">
      <h3>No candidates in this evidence revision</h3>
      <% if @review_case.status == "pending" %>
        <% if @creation_state == :ready %>
          <p>No credible candidates remain. This case is ready for a separate explicit creation decision below.</p>
        <% else %>
          <p>This case remains pending review. Creation needs complete metadata and no remaining credible candidates.</p>
        <% end %>
      <% elsif @review_case.status == "superseded" %>
        <p>This historical evidence is retained for audit. The case was superseded.</p>
      <% else %>
        <p>This case has a final decision. No candidates were recorded in this evidence revision.</p>
      <% end %>
    </div>
  <% else %>
    <% @candidates.each do |candidate| %>
      <article class="panel candidate-card">
        <h3>Rank <%= candidate.rank %> · Product #<%= candidate.product_id %></h3>
        <p><strong>Match score:</strong> <%= number_to_percentage(candidate.score * 100, precision: 1) %> · <strong>Different fields:</strong> <%= candidate.differing_fields.any? ? candidate.differing_fields.join(", ") : "None" %></p>
        <% if candidate.review_rejection %><p class="rejection-note">Rejected by <%= candidate.review_rejection.reviewer %> at <%= time_tag candidate.review_rejection.rejected_at, candidate.review_rejection.rejected_at.strftime("%Y-%m-%d %H:%M %Z") %>: <%= candidate.review_rejection.reason %></p><% end %>
        <% if @rejected_product_ids.include?(candidate.product_id) && !candidate.review_rejection %><p class="rejection-note">Previously rejected. That rejection remains in effect after rematching.</p><% end %>
        <div class="table-wrap">
          <table class="identity-table">
            <caption>Candidate product values</caption>
            <thead><tr><th scope="col">Field</th><th scope="col">Catalog value</th><th scope="col">Normalized comparison</th></tr></thead>
            <tbody>
              <% %w[name brand category].each do |field| %>
                <tr><th scope="row"><%= field.humanize %></th><td><%= candidate.original[field].presence || "—" %></td><td><%= candidate.comparison[field].presence || "—" %></td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <%= render "conflict", conflict: candidate.conflicting_association %>
        <% if @review_case.status == "pending" && @creation_state != :invalid_input && !@rejected_product_ids.include?(candidate.product_id) %>
          <div class="candidate-actions">
            <% if @review_case.seller_item.product_id.nil? && @review_case.conflicting_association.blank? && candidate.conflicting_association.blank? %>
              <%= form_with url: approve_review_case_path(@review_case), method: :post do |form| %>
                <%= form.hidden_field :candidate_id, value: candidate.id %>
                <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
                <%= form.submit "Approve product ##{candidate.product_id}", class: "button" %>
              <% end %>
            <% elsif candidate.conflicting_association.present? && candidate.conflicting_association["seller_product_id"] != @review_case.seller_item.seller_product_id %>
              <% existing_id = candidate.conflicting_association["seller_product_id"] %>
              <p>One seller offers product #<%= candidate.product_id %> under IDs <strong><%= existing_id %></strong> and <strong><%= @review_case.seller_item.seller_product_id %></strong>. Choose the surviving ID.</p>
              <%= form_with url: keep_existing_review_case_path(@review_case), method: :post do |form| %>
                <%= form.hidden_field :candidate_id, value: candidate.id %>
                <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
                <%= form.submit "Keep existing ID #{existing_id}; decline incoming ID #{@review_case.seller_item.seller_product_id}", class: "button button--secondary" %>
              <% end %>
              <%= form_with url: replace_existing_review_case_path(@review_case), method: :post do |form| %>
                <%= form.hidden_field :candidate_id, value: candidate.id %>
                <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
                <%= form.submit "Replace ID #{existing_id} with incoming ID #{@review_case.seller_item.seller_product_id}", class: "button" %>
              <% end %>
            <% elsif @review_case.conflicting_association.present? && @review_case.conflicting_association["seller_product_id"] == @review_case.seller_item.seller_product_id %>
              <%= form_with url: reassign_candidate_review_case_path(@review_case), method: :post do |form| %>
                <%= form.hidden_field :candidate_id, value: candidate.id %>
                <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
                <%= form.submit "Reassign seller ID #{@review_case.seller_item.seller_product_id} to product ##{candidate.product_id}", class: "button" %>
              <% end %>
            <% else %>
              <p class="muted">Reload and review the current association before choosing this candidate.</p>
            <% end %>
            <%= form_with url: reject_review_case_path(@review_case), method: :post, class: "reject-form" do |form| %>
              <%= form.hidden_field :candidate_id, value: candidate.id %>
              <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
              <%= form.label :reason, "Reason for rejecting product ##{candidate.product_id}" %>
              <%= form.text_field :reason, required: true %>
              <%= form.submit "Reject product ##{candidate.product_id}", class: "button button--secondary" %>
            <% end %>
          </div>
        <% end %>
      </article>
    <% end %>
    <% if @review_case.status == "pending" && @candidates.all? { |candidate| @rejected_product_ids.include?(candidate.product_id) } %>
      <p class="muted">All current candidates have been rejected. This case stays pending until a separate explicit creation decision.</p>
    <% end %>
  <% end %>
</section>

<% if @review_case.status == "pending" %>
  <section class="case-section" aria-labelledby="creation-heading">
    <h2 id="creation-heading">Create a new product</h2>
    <div class="panel">
      <% case @creation_state %>
      <% when :invalid_input %>
        <p>The current input fails validation. Correct Name, Brand, or Category where possible, or submit a corrected row in a new import.</p>
      <% when :ready %>
        <p>Ready for explicit creation from the current comparison values. Catalog candidates will be checked again when you submit.</p>
        <%= form_with url: create_product_review_case_path(@review_case), method: :post do |form| %>
          <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
          <%= form.submit "Create new product and link seller item", class: "button" %>
        <% end %>
      <% when :incomplete %>
        <p>Complete Brand and Category using the correction form before creating a product.</p>
      <% when :association_conflict %>
        <% if @reassignment_creation_state == :ready %>
          <p>All current candidates have been rejected. The existing association will move to a new product only after this explicit decision.</p>
          <%= form_with url: create_for_reassignment_review_case_path(@review_case), method: :post do |form| %>
            <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
            <%= form.submit "Create new product and reassign seller ID #{@review_case.seller_item.seller_product_id}", class: "button" %>
          <% end %>
        <% elsif @reassignment_creation_state == :incomplete %>
          <p>Complete Brand and Category using the correction form before creating a replacement product.</p>
        <% else %>
          <p>Reject every remaining credible candidate before creating a replacement product.</p>
        <% end %>
      <% else %>
        <p>Review or reject every remaining credible candidate before creating a product.</p>
      <% end %>
    </div>
  </section>
<% end %>

<% if @review_case.status == "pending" %>
  <section class="case-section" aria-labelledby="correction-heading">
    <h2 id="correction-heading">Correct comparison values</h2>
    <div class="panel">
      <p>Corrections leave the original seller row and seller ID unchanged. Matching runs again, and the case stays pending until a separate decision.</p>
      <%= form_with url: correct_review_case_path(@review_case), method: :post, class: "correction-form" do |form| %>
        <%= form.hidden_field :evidence_revision, value: @review_case.evidence_revision %>
        <div><%= form.label :name, "Name" %><%= form.text_field :name, value: @current_input["Name"], required: true %></div>
        <div><%= form.label :brand, "Brand" %><%= form.text_field :brand, value: @current_input["Brand"] %></div>
        <div><%= form.label :category, "Category" %><%= form.text_field :category, value: @current_input["Category"] %></div>
        <%= form.submit "Save correction and rematch", class: "button" %>
      <% end %>
    </div>
  </section>
<% end %>

<section class="case-section" aria-labelledby="history-heading">
  <h2 id="history-heading">Review history</h2>
  <% if @history_events.empty? %>
    <p class="panel empty-state">No reviewer actions have been recorded.</p>
  <% else %>
    <ol class="panel history-list">
      <% @history_events.each do |event| %>
        <% case event %>
        <% when Intake::Models::ReviewCorrection %>
          <li>Correction by <%= event.reviewer %> at <%= time_tag event.corrected_at, event.corrected_at.strftime("%Y-%m-%d %H:%M %Z") %>.</li>
        <% when Intake::Models::ReviewRejection %>
          <li>Product #<%= event.review_candidate.product_id %> rejected by <%= event.reviewer %> at <%= time_tag event.rejected_at, event.rejected_at.strftime("%Y-%m-%d %H:%M %Z") %>: <%= event.reason %></li>
        <% when Intake::Models::ReviewDecision %>
          <li>Final decision: <%= event.result.humanize %>, product #<%= event.product_id %>, by <%= event.reviewer %> at <%= time_tag event.decided_at, event.decided_at.strftime("%Y-%m-%d %H:%M %Z") %><% if event.reason.present? %>: <%= event.reason %><% end %>.</li>
        <% end %>
      <% end %>
    </ol>
  <% end %>
</section>

<section class="case-section" aria-labelledby="imports-heading">
  <h2 id="imports-heading">Recorded import outcomes</h2>
  <p class="muted">These are the immutable results from each import. A later decision changes the case state shown above, not the prior row outcome.</p>
  <div class="table-wrap panel">
    <table>
      <caption>Rows referencing case #<%= @review_case.id %></caption>
      <thead><tr><th scope="col">Batch and row</th><th scope="col">Import-time outcome</th><th scope="col">Import-time reason</th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr><th scope="row"><%= link_to "Batch ##{row.batch_id}, row #{row.source_position}", batch_path(row.batch) %></th><td><%= row.outcome.humanize %></td><td><%= row.reason %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<p class="secondary-link"><%= link_to "Back to review queue", review_cases_path %> · <%= link_to "All batches", batches_path %></p>
