# Mutator for sends that correspond to a binary operator
#
# pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:9
class Mutant::Mutator::Node::Send::Binary < ::Mutant::Mutator::Node::Send
  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_left(node); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_left_mutations(&block); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_operator(node); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_operator_mutations(&block); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_right(node); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def emit_right_mutations(&block); end

  private

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:22
  def dispatch; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:76
  def emit_not_equality_mutation(new_operator); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:69
  def emit_not_equality_mutations; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:31
  def emit_selector_replacement; end

  # Multiplication and division by 1 or -1 are equivalent operations:
  #   a * 1  == a / 1   (both equal a)
  #   a * -1 == a / -1  (both equal -a)
  #
  # Swapping * <-> / when RIGHT operand is 1 or -1 produces an equivalent
  # mutant that can never be killed, wasting test resources.
  #
  # Note: LEFT operand identity (e.g., 1 * a -> 1 / a) produces different
  # results (a vs 1/a) and should NOT be skipped.
  #
  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:50
  def equivalent_multiplication_division_swap?(replacement); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def left; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:54
  def multiplicative_identity?(node); end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def operator; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def remaining_children; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def remaining_children_indices; end

  # pkg:gem/mutant#lib/mutant/mutator/node/send/binary.rb:11
  def right; end
end

# Pairs of operators where swapping produces equivalent mutants
# when the right operand is a multiplicative identity (1 or -1).
#
