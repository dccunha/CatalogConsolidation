  def initialize(*); end

  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:9
  def env; end

  # Handle mutation finish
  #
  # @param [Parallel::Response] response
  #
  # @return [self]
  #
  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:49
  def response(response); end

  # Runner status
  #
  # @return [Result::Env]
  #
  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:27
  def status; end

  # Test if scheduling stopped
  #
  # @return [Boolean]
  #
  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:38
  def stop?; end

  private

  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:96
  def coverage_result(mutation_result); end

  # Persist the session on alive mutations, so survivors are
  # inspectable while a long run is still going, rather than only
  # after its final write.
  #
  # Alive mutations can arrive far faster than once per second, and
  # each flush serializes the whole result tree on the main process,
  # so flushes are rate limited against the monotonic timer. A
  # survivor that lands inside the suppressed window is picked up by
  # the next flush, or by the final write in the runner.
  #
  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:86
  def flush_session; end

  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:103
  def mutation_result(mutation, mutation_index_result); end

  # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:115
  def previous_coverage_results(subject); end

  class << self
    # pkg:gem/mutant#lib/mutant/mutation/runner/sink.rb:9
    def anima; end
  end
end

