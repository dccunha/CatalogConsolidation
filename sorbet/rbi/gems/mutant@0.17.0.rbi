# Bootstrap process
#
# The role of the boostrap is to take the pure config and apply it against
# the impure world to produce an environment.
#
# env = config interpreted against the world
#
# pkg:gem/mutant#lib/mutant/bootstrap.rb:12
module Mutant::Bootstrap
  include ::Unparser::Anima::InstanceMethods
  include ::Unparser::Equalizer::InstanceMethods
  include ::Unparser::Equalizer::InspectMethods
  include ::Unparser::Adamantium
  include ::Unparser::Adamantium::InstanceMethods
  extend ::Unparser::Adamantium::ModuleMethods

  # pkg:gem/mutant#lib/mutant/bootstrap.rb:13
  def config; end

  # pkg:gem/mutant#lib/mutant/bootstrap.rb:13
  def parser; end

  # pkg:gem/mutant#lib/mutant/bootstrap.rb:13
  def world; end

  class << self
    # pkg:gem/mutant#lib/mutant/bootstrap.rb:13
    def anima; end

    # Run Bootstrap
    #
    # @param [Env] env
    #
    # @return [Either<String, Env>]
    #
    # pkg:gem/mutant#lib/mutant/bootstrap.rb:43
    def call(env); end

    # Run test only bootstrap
    #
    # @param [Env] env
    #
    # @return [Either<String, Env>]
    #
    # pkg:gem/mutant#lib/mutant/bootstrap.rb:73
    def call_test(env); end

    private

    # A recording that names no test of this suite was taken somewhere else, and
    # answering selection from it would report every mutation alive without ever
    # running a test that could have killed it.
    #
    # @return [Either<String, Selector>]
    #
    # pkg:gem/mutant#lib/mutant/bootstrap.rb:134
    def context_map_selector(context_map:, fallback:, integration:); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:221
    def expression(reporter, expression_parser, raw_scope); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:166
    def infect(env); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:142
    def load_hooks(env); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:192
    def matchable_scopes(env); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:206
    def scope_name(reporter, raw_scope); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:240
    def semantics_warning(reporter, format, options); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:85
    def setup_integration(env:, mutations:, selected_subjects:); end

    # The selector the configured strategy asks for
    #
    # The default is to use the coverage recording whenever there is a usable
    # one and the expressions otherwise, so a project that records per test
    # coverage gets the better selection without asking for it. Naming
    # `context_map` explicitly turns every reason the recording cannot be used
    # into a failed run, rather than a silent downgrade to a selection the user
    # did not ask for.
    #
    # @return [Either<String, Selector>]
    #
    # pkg:gem/mutant#lib/mutant/bootstrap.rb:113
    def setup_selector(env:, integration:); end

    # pkg:gem/mutant#lib/mutant/bootstrap.rb:149
    def subject_select(env, subjects); end
  end
end

