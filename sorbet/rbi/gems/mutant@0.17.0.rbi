# Format for progressive non rewindable output
#
# pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:76
class Mutant::Reporter::CLI::Format::Progressive < ::Mutant::Reporter::CLI::Format
  # Progress representation
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:106
  def progress(status); end

  # Start representation
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:92
  def start(env); end

  # Progress representation
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:113
  def test_progress(status); end

  # Test start representation
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:99
  def test_start(env); end

  private

  # Build escape sequence to clear n lines (indicatif/console pattern)
  #
  # Algorithm from console crate's clear_last_lines:
  # 1. Move cursor up (n-1) lines to reach top
  # 2. For each line: clear it, move down (except last)
  # 3. Move cursor back up (n-1) lines
  #
  # For n=1: produces "\r\e[2K" (no cursor movement needed)
  # For n>1: moves up, clears each line with downs between, moves back up
  #
  # @param lines [Integer] number of lines to clear (must be >= 1)
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:175
  def clear_last_lines(lines); end

  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:119
  def new_buffer; end

  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:121
  def status_progressive_printer; end

  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:123
  def test_status_progressive_printer; end

  # Calculate visual length of string (excluding ANSI escape sequences)
  #
  # @param string [String]
  # @return [Integer]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:147
  def visual_length(string); end

  # Calculate visual lines content occupies at given terminal width
  #
  # @param content_length [Integer, nil]
  # @param width [Integer]
  # @return [Integer]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:156
  def visual_lines_at_width(content_length, width); end

  # Wrap progress output with TTY-specific line handling
  #
  # Uses indicatif-style multi-line clearing to handle terminal resize:
  # 1. Calculate how many visual lines previous content spans at current width
  # 2. Clear all those lines using cursor movement
  # 3. Write new content
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/reporter/cli/format.rb:133
  def wrap_progress; end
end

