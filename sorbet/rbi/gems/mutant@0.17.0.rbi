  # pkg:gem/mutant#lib/mutant/config.rb:11
  def hooks; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def includes; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def integration; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def isolation; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def jobs; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def matcher; end

  # Merge with other config
  #
  # @param [Config] other
  #
  # @return [Config]
  #
  # pkg:gem/mutant#lib/mutant/config.rb:81
  def merge(other); end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def mutation; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def reporter; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def requires; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
  def selection; end

  # pkg:gem/mutant#lib/mutant/config.rb:11
