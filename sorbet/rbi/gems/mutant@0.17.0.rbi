# Per test coverage, read from the artifact a coverage tool wrote.
#
# Mutant does not depend on the tool that produces the recording. It reads
# the `contexts` sections of simplecov's `coverage.json`, which appear once
# `track_tests` is enabled: an interned list of test ids, and per source file
# a bitmap of the lines each of those tests executed.
#
# The recording answers the question the expression selector can only guess
# at, which tests actually executed the lines a subject is made of.
#
# pkg:gem/mutant#lib/mutant/context_map.rb:13
class Mutant::ContextMap
  include ::Unparser::Anima::InstanceMethods
  include ::Unparser::Equalizer::InstanceMethods
  include ::Unparser::Equalizer::InspectMethods
  include ::Unparser::Adamantium
  include ::Unparser::Adamantium::InstanceMethods
  extend ::Unparser::Adamantium::ModuleMethods
  extend ::Unparser::Adamantium::ClassMethods

  # Every test id the recording knows about
  #
  # @return [Set<String>]
  #
  # pkg:gem/mutant#lib/mutant/context_map.rb:97
  def context_ids(&block); end

  # Lines a test executed across the whole project
  #
  # The share of that footprint falling inside a subject is how focused the
  # test is on it. A unit test spends most of its lines there, while a
  # feature spec touching thousands of lines spends almost none.
  #
  # @param [String] context
  #
  # @return [Integer]
  #
  # pkg:gem/mutant#lib/mutant/context_map.rb:82
  def footprint(context); end

  # Absolute `path:line` form of a location, against this recording's root
  #
  # @param [String] location
  #
  # @return [String]
  #
  # pkg:gem/mutant#lib/mutant/context_map.rb:45
  def normalize(location); end

  # How many of `lines` in `path` each test executed, for the tests that
  # executed any of them
  #
  # The count is what ranks the tests: one that ran the whole method body is
  # likelier to reach a mutated expression than one that grazed a guard.
  #
  # @param [Pathname] path
  # @param [Range<Integer>] lines
  #
  # @return [Hash{String => Integer}]
  #
  # pkg:gem/mutant#lib/mutant/context_map.rb:57
  def reach(path:, lines:); end

  # pkg:gem/mutant#lib/mutant/context_map.rb:14
  def root; end

  # pkg:gem/mutant#lib/mutant/context_map.rb:14
  def tables; end

  private

  # pkg:gem/mutant#lib/mutant/context_map.rb:102
  def footprints(&block); end

  class << self
    # pkg:gem/mutant#lib/mutant/context_map.rb:14
    def anima; end

    # Absolute `path:line` form of a location
    #
    # Test ids are recorded relative to the project root, while the
    # integrations report locations the way their framework spells them. Both
    # sides pass through here so that they compare as strings.
    #
    # @param [String] location
    # @param [String] root
    #
    # @return [String]
    #
    # pkg:gem/mutant#lib/mutant/context_map.rb:32
    def normalize(location, root); end

    # Number of set bits
    #
    # Ruby has no population count on Integer, and a binary string is both the
    # idiom and fast enough at the sizes a line bitmap reaches.
    #
    # @param [Integer] value
    #
    # @return [Integer]
    #
    # pkg:gem/mutant#lib/mutant/context_map.rb:92
    def popcount(value); end
  end
end

# Basename simplecov writes its report under
#
# pkg:gem/mutant#lib/mutant/context_map.rb:17
Mutant::ContextMap::ARTIFACT_BASENAME = T.let(T.unsafe(nil), String)

# Reads simplecov's `coverage.json` into a ContextMap
#
# Every way the read can fail ends in an explanation of how to produce the
# recording, because the recording is the whole reason the strategy was
# asked for.
#
# pkg:gem/mutant#lib/mutant/context_map/loader.rb:12
class Mutant::ContextMap::Loader
  include ::Unparser::Anima::InstanceMethods
  include ::Unparser::Equalizer::InstanceMethods
  include ::Unparser::Equalizer::InspectMethods

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:13
  def artifact; end

  # Load the recording
  #
  # @return [Either<String, ContextMap>]
  #
  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:174
  def call; end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:13
  def world; end

  private

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:195
  def decode(data); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:203
  def error(message, **arguments); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:207
  def from_document(document); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:218
  def load_tables(contexts:, coverage:, root:); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:191
  def parse(contents); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:185
  def read; end

  # nil on an index outside the recording's list. A half read recording
  # would answer coverage questions with silent gaps, and a silent gap is
  # a mutation reported alive that no test was ever given the chance to
  # kill.
  #
  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:236
  def resolve(ids:, table:); end

  # pkg:gem/mutant#lib/mutant/context_map/loader.rb:199
  def unreadable(exception); end

  class << self
    # pkg:gem/mutant#lib/mutant/context_map/loader.rb:13
    def anima; end

    # Load the recording under path
    #
    # @return [Either<String, ContextMap>]
    #
    # pkg:gem/mutant#lib/mutant/context_map/loader.rb:165
    def call(path:, world:); end

    private

    # An integer written as digits in a base, and nothing else
    #
    # Kernel#Integer would also take a sign, a prefix, whitespace or
    # underscores, none of which the format allows.
    #
    # pkg:gem/mutant#lib/mutant/context_map/loader.rb:89
    def parse_digits(string, base:, pattern:); end
  end
end

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:98
Mutant::ContextMap::Loader::CONTEXT_INDEX = T.let(T.unsafe(nil), Mutant::Transform::Sequence)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:145
Mutant::ContextMap::Loader::COVERAGE = T.let(T.unsafe(nil), Mutant::Transform::Hash::Map)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:147
Mutant::ContextMap::Loader::DOCUMENT = T.let(T.unsafe(nil), Mutant::Transform::Sequence)

# The report carries far more than mutant reads, and gains keys between
# minor schema versions. Each hash below is sliced to the keys mutant
# names before the strict transform sees it.
#
# A file with no `contexts` section is one no recorded test executed, and
# contributes nothing rather than making the recording unreadable.
#
# pkg:gem/mutant#lib/mutant/context_map/loader.rb:122
Mutant::ContextMap::Loader::FILE = T.let(T.unsafe(nil), Mutant::Transform::Sequence)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:44
Mutant::ContextMap::Loader::INVALID_ARTIFACT = T.let(T.unsafe(nil), String)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:105
Mutant::ContextMap::Loader::LINE_BITMAP = T.let(T.unsafe(nil), Mutant::Transform::Sequence)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:132
Mutant::ContextMap::Loader::META = T.let(T.unsafe(nil), Mutant::Transform::Sequence)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:15
Mutant::ContextMap::Loader::MISSING_ARTIFACT = T.let(T.unsafe(nil), String)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:83
Mutant::ContextMap::Loader::NOT_DIGITS = T.let(T.unsafe(nil), String)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:66
Mutant::ContextMap::Loader::NO_CONTEXTS = T.let(T.unsafe(nil), String)

# Per source file: the index of each test that executed it, and a bitmap
# of the lines it executed
#
# pkg:gem/mutant#lib/mutant/context_map/loader.rb:114
Mutant::ContextMap::Loader::TABLE = T.let(T.unsafe(nil), Mutant::Transform::Hash::Map)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:82
Mutant::ContextMap::Loader::UNKNOWN_CONTEXT = T.let(T.unsafe(nil), String)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:56
Mutant::ContextMap::Loader::UNKNOWN_SCHEMA = T.let(T.unsafe(nil), String)

# pkg:gem/mutant#lib/mutant/context_map/loader.rb:36
Mutant::ContextMap::Loader::UNREADABLE_ARTIFACT = T.let(T.unsafe(nil), String)

