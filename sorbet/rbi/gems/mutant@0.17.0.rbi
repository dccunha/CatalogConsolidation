# Lightweight concurrency variables
#
# These are inspired by Haskells MVar and IVar types.
#
# pkg:gem/mutant#lib/mutant/variable.rb:7
class Mutant::Variable
  # Initialize object
  #
  # @param [Object] value
  #   the initial value
  #
  # @return [undefined]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:83
  def initialize(condition_variable:, mutex:, value: T.unsafe(nil)); end

  # Read value, block on empty
  #
  # @return [Object]
  #   the variable value
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:122
  def read; end

  # Take value, block on empty
  #
  # @return [Object]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:92
  def take; end

  # Take value, with timeout
  #
  # @param [Float] Timeout
  #
  # @return [Result::Timeout]
  #   in case take resulted in a timeout
  #
  # @return [Result::Value]
  #   in case take resulted in a value
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:108
  def take_timeout(timeout); end

  # Try put value into the variable, non blocking
  #
  # @param [Object] value
  #
  # @return [self]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:134
  def try_put(value); end

  # Execute block with value, blocking
  #
  # @yield [Object]
  #
  # @return [Object]
  #   the blocks return value
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:148
  def with; end

  private

  # Test if state is empty
  #
  # @return [Boolean]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:212
  def empty?; end

  # Test if state is full
  #
  # @return [Boolean]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:205
  def full?; end

  # Perform the put
  #
  # @param [Object] value
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:160
  def perform_put(value); end

  # Execute block under mutex
  #
  # @return [self]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:167
  def synchronize(&); end

  # Wait for block predicate
  #
  # @param [ConditionVariable] event
  #
  # @return [undefined]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:176
  def wait(event); end

  # Wait till mvar is full
  #
  # @return [undefined]
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:200
  def wait_full; end

  # Wait with timeout for block predicate
  #
  # @param [ConditionVariable] event
  #
  # @return [Boolean]
  #   if wait was terminated due a timeout
  #
  # @return [undefined]
  #   otherwise
  #
  # pkg:gem/mutant#lib/mutant/variable.rb:189
  def wait_timeout(event, timeout); end
end

